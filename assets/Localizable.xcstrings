    "onboarding.menu.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the current state and holds all options – the shortcut can be changed there, too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Zustand und enthält alle Optionen – auch das Tastenkürzel lässt sich dort ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il indique l’état actuel et regroupe toutes les options – le raccourci s’y modifie aussi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el estado actual y contiene todas las opciones; ahí también puedes cambiar el atajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra lo stato attuale e contiene tutte le opzioni: da lì puoi cambiare anche l’abbreviazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o estado atual e reúne todas as opções – o atalho também pode ser alterado ali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の状態を表示し、すべてのオプションがここにあります。ショートカットもここで変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示当前状态并包含所有选项，快捷键也可以在那里更改。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 상태를 보여 주고 모든 옵션이 들어 있습니다. 단축키도 여기에서 변경할 수 있습니다."
