    "onboarding.safe.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icons are only hidden, never deleted or moved. When you quit, everything is back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur ausgeblendet, nie gelöscht oder verschoben. Beim Beenden ist alles wieder da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les icônes sont seulement masquées, jamais supprimées ni déplacées. Tout réapparaît lorsque vous quittez l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los iconos solo se ocultan, nunca se eliminan ni se mueven. Al salir, todo vuelve a estar ahí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le icone vengono solo nascoste, mai eliminate o spostate. Quando esci dall’app, torna tutto al suo posto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ícones são apenas ocultados, nunca apagados nem movidos. Ao encerrar o app, tudo volta ao lugar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンは隠すだけで、削除も移動もしません。アプリを終了するとすべて元に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标只是被隐藏，绝不会被删除或移动。退出 App 后，一切恢复原样。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘은 가려질 뿐 삭제되거나 이동되지 않습니다. 앱을 종료하면 모두 원래대로 돌아옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значки только скрываются, они не удаляются и не перемещаются. При завершении приложения всё возвращается."
          }
        }
      }
    },
    "onboarding.safe.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing gets lost"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts geht verloren"
          }
        },
        "fr": {
