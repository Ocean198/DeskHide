          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не пропадёт"
          }
        }
      }
    },
    "onboarding.shortcut.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press once to hide them, press again to bring them back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal drücken blendet aus, noch einmal drücken blendet wieder ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui masque les icônes, un second les réaffiche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Púlsalo una vez para ocultarlos y otra para volver a mostrarlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi una volta per nasconderle, premi di nuovo per farle riapparire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione uma vez para ocultar e outra vez para mostrar novamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回押すと隠れ、もう一度押すと元に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一次隐藏，再按一次恢复显示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 누르면 가려지고, 다시 누르면 다시 나타납니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно нажатие скрывает значки, повторное – возвращает их."
          }
        }
      }
    },
