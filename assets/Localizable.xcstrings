    "onboarding.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides your desktop icons for clean screenshots – and brings them back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet deine Schreibtischsymbole für saubere Screenshots aus – und wieder ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les icônes de votre bureau pour des captures d’écran nettes – et les réaffiche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los iconos del escritorio para hacer capturas de pantalla limpias, y los vuelve a mostrar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde le icone della scrivania per screenshot puliti, e le fa riapparire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os ícones da mesa para capturas de tela limpas – e os traz de volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットをすっきり撮れるよう、デスクトップのアイコンを隠し、また元に戻します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏桌面图标，让截屏干净整洁，并可随时恢复显示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깔끔한 스크린샷을 위해 데스크탑 아이콘을 가리고 다시 표시합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает значки рабочего стола для аккуратных снимков экрана – и возвращает их обратно."
          }
        }
      }
    },
