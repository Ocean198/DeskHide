{
  "sourceLanguage": "en",
  "strings": {
    "alert.finder.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is probably busy copying files. The desktop icons were left unchanged – try again once it has finished."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermutlich läuft dort gerade ein Kopiervorgang. Die Schreibtischsymbole bleiben unverändert – versuch es danach noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est probablement en train de copier des fichiers. Les icônes du bureau n’ont pas été modifiées – réessayez une fois la copie terminée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probablemente esté copiando archivos. Los iconos del escritorio no se han modificado; vuelve a intentarlo cuando termine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilmente sta copiando dei file. Le icone della scrivania non sono state modificate: riprova al termine della copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele provavelmente está copiando arquivos. Os ícones da mesa não foram alterados – tente novamente quando a cópia terminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをコピー中の可能性があります。デスクトップのアイコンは変更されていません。コピーが終わってからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访达可能正在拷贝文件。桌面图标未作更改，请在拷贝完成后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 복사하는 중일 수 있습니다. 데스크탑 아이콘은 변경되지 않았습니다. 복사가 끝난 후 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вероятно, он сейчас копирует файлы. Значки рабочего стола не изменены – повторите попытку после завершения копирования."
          }
        }
      }
    },
    "alert.finder.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder could not be restarted"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder ließ sich nicht neu starten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de redémarrer le Finder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reiniciar el Finder"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile riavviare il Finder"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível reiniciar o Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finderを再起動できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新启动访达"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder를 재시동할 수 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось перезапустить Finder"
          }
        }
      }
    },
    "alert.login.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login item could not be changed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldeobjekt konnte nicht geändert werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier l’élément d’ouverture"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el ítem de inicio de sesión"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile modificare l’elemento login"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar o item de início de sessão"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目を変更できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改登录项"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목을 변경할 수 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить объект входа"
          }
        }
      }
    },
    "alert.shortcut.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already in use by another app. Pick a different combination with “Change Shortcut…”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird bereits von einem anderen Programm verwendet. Wähle über „Tastenkürzel ändern …“ eine andere Kombination."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà utilisé par une autre app. Choisissez une autre combinaison via « Modifier le raccourci… »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya lo usa otra app. Elige otra combinación con «Cambiar atajo…»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già utilizzata da un’altra app. Scegli un’altra combinazione con “Cambia abbreviazione…”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já está sendo usado por outro app. Escolha outra combinação em “Alterar Atalho…”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はすでにほかのアプリで使用されています。“ショートカットを変更…”から別の組み合わせを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被其他 App 使用。请通过“更改快捷键…”选择其他组合。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이미 다른 앱에서 사용 중입니다. ‘단축키 변경…’에서 다른 조합을 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание %@ уже используется другим приложением. Выберите другое в пункте «Изменить сочетание клавиш…»."
          }
        }
      }
    },
