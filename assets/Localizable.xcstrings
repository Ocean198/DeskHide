    "option.thorough.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the icons hidden even when you show the desktop or use hot corners. In return, Finder briefly restarts every time you toggle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält die Symbole auch bei „Schreibtisch einblenden“ und aktiven Ecken verborgen. Dafür startet der Finder bei jedem Umschalten kurz neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les icônes restent masquées même lorsque vous affichez le bureau ou utilisez les coins actifs. En contrepartie, le Finder redémarre brièvement à chaque basculement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene los iconos ocultos incluso al mostrar el escritorio o usar las esquinas activas. A cambio, el Finder se reinicia brevemente cada vez que alternas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene le icone nascoste anche quando mostri la scrivania o usi gli angoli attivi. In cambio, il Finder si riavvia brevemente a ogni attivazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os ícones ocultos mesmo quando você mostra a mesa ou usa os cantos ativos. Em troca, o Finder reinicia rapidamente a cada alternância."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップを表示したときやホットコーナーを使ったときも、アイコンを隠したままにします。その代わり、切り替えるたびにFinderが短時間再起動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使显示桌面或使用触发角，图标也保持隐藏。相应地，每次切换时访达都会短暂重新启动。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크탑을 표시하거나 핫 코너를 사용할 때에도 아이콘을 가린 상태로 유지합니다. 대신 전환할 때마다 Finder가 잠시 재시동됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значки остаются скрытыми, даже когда Вы показываете рабочий стол или используете активные углы. Взамен Finder ненадолго перезапускается при каждом переключении."
          }
        }
      }
    },
